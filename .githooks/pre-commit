#!/bin/sh
# Enabled by `just setup-hooks` (git config core.hooksPath .githooks).
# Only warns; never blocks the commit.
root="$(git rev-parse --show-toplevel)"
if ! git-crypt status -e >/dev/null 2>&1; then
    git-crypt status -e >&2
    echo "WARNING: git-crypt: unencrypted file(s) staged" >&2
fi
just --justfile "$root/justfile" --working-directory "$root" learnings-check \
    || echo "WARNING: learnings.tar is stale" >&2
exit 0
